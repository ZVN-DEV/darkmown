tokens
  ink #1d2530
  paper #fbfaf7
  muted #6b7785
  accent #2f6df0

page
  margin 0
  font ui-sans-serif, system-ui, sans-serif
  color $ink
  bg $paper
  line-height 1.6

main
  max-width 720px
  margin 0 auto
  padding 2.5rem 1.5rem

nav
  display flex
  align-items center
  justify-content space-between
  max-width 720px
  margin 0 auto
  padding 1.25rem 1.5rem

nav strong
  font-size 1.1rem

nav a
  color $accent
  text-decoration none

.post-card
  padding 1.5rem 0
  border-bottom 1px solid #e7e3da

.post-card h3
  margin 0 0 .25rem

.post-card a
  color $ink
  text-decoration none

.post-card a:hover
  color $accent

.post-meta
  margin 0 0 .5rem
  color $muted
  font-size .9rem
