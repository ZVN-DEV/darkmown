/* Colocated page styling — a .skin next to a .md attaches automatically. */

tokens
  ink #172026
  muted #5b6b72
  paper #f7f2e8
  panel #ffffff
  line #e4ddcd
  accent #0f8b8d

tokens dark
  ink #e8eef0
  muted #93a3a8
  paper #11181b
  panel #182226
  line #2a363a
  accent #3fc6c8

html
  bg $paper

page
  margin 0
  font ui-sans-serif, system-ui, sans-serif
  color $ink
  bg $paper
  line-height 1.6
  -webkit-font-smoothing antialiased

main
  max-width 760px
  margin 0 auto
  padding 3rem 1.5rem

a
  color $accent

code
  font ui-monospace, SFMono-Regular, Menlo, monospace
  font-size .88em
  bg $panel
  border 1px solid $line
  padding .08rem .28rem
  radius 5px
