tokens
  ink #172026
  muted #5b6b72
  paper #f7f2e8
  panel #ffffff
  line #e4ddcd
  accent #0f8b8d
  accent-deep #0b6e70
  ring #0f8b8d
  radius 10px

tokens dark
  ink #e8eef0
  muted #93a3a8
  paper #11181b
  panel #182226
  line #2a363a
  accent #3fc6c8
  accent-deep #6fdadb
  ring #3fc6c8

page
  margin 0
  font ui-sans-serif, system-ui, sans-serif
  color $ink
  bg $paper
  line-height 1.6
  -webkit-font-smoothing antialiased

main
  max-width 760px
  margin 0 auto
  padding 3rem 1.5rem

nav
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  max-width 760px
  margin 0 auto
  padding 1.25rem 1.5rem

nav strong
  font-size 1.1rem

nav .links
  display flex
  gap 1.25rem

nav a
  color $ink
  text-decoration none
  opacity .8

nav a:hover
  opacity 1
  color $accent

button
  display inline-flex
  align-items center
  justify-content center
  gap .5rem
  bg $accent
  color white
  border 1px solid $accent
  padding .6rem 1.15rem
  margin .4rem .5rem .4rem 0
  radius 999px
  font-size .94rem
  font-weight 560
  line-height 1.15
  cursor pointer
  appearance none
  box-shadow 0 1px 2px rgba(23,32,38,.08)
  transition transform .14s cubic-bezier(.2,.7,.3,1), box-shadow .14s ease, background .14s ease, border-color .14s ease

button:hover
  bg $accent-deep
  border-color $accent-deep
  transform translateY(-1px)
  box-shadow 0 8px 18px -8px rgba(15,139,141,.55)

button:active
  transform translateY(0)
  box-shadow 0 1px 2px rgba(23,32,38,.08)

button:focus-visible
  outline 2px solid $ring
  outline-offset 2px

button:disabled
  opacity .5
  cursor not-allowed
  box-shadow none
  transform none

input, textarea, select
  font inherit
  font-size .95rem
  color $ink
  bg $panel
  border 1px solid $line
  radius $radius
  padding .58rem .8rem
  margin .35rem 0
  width 100%
  max-width 24rem
  appearance none
  transition border-color .14s ease, box-shadow .14s ease

input:hover, textarea:hover, select:hover
  border-color $accent

input:focus-visible, textarea:focus-visible, select:focus-visible
  outline none
  border-color $accent
  box-shadow 0 0 0 3px rgba(15,139,141,.18)

@media (prefers-reduced-motion: reduce)
  button
    transition none
  button:hover
    transform none
