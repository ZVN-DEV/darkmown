tokens
  ink #1a1f2b
  paper #fbfbf9
  line #e6e4dd
  accent #146b54

page
  margin 0
  font ui-sans-serif, system-ui, sans-serif
  color $ink
  bg $paper
  line-height 1.55

main
  max-width 860px
  margin 0 auto
  padding 2rem 1.5rem

nav
  display flex
  align-items center
  justify-content space-between
  max-width 860px
  margin 0 auto
  padding 1.25rem 1.5rem

nav strong
  font-size 1.1rem

nav a
  color $accent
  text-decoration none

input
  font inherit
  padding .6rem .75rem
  border 1px solid $line
  radius 8px
  width 100%
  max-width 320px

.catalog
  display grid
  grid-template-columns repeat(auto-fill, minmax(160px, 1fr))
  gap 1rem
  margin 1.5rem 0

.product
  border 1px solid $line
  radius 12px
  padding 1rem
  text-align center
  background white

.emoji
  font-size 2.25rem

.pname
  font-weight 600
  margin .35rem 0 .15rem

.price
  color $accent
  font-weight 600
  margin-bottom .6rem

button
  font inherit
  bg $accent
  color white
  border 0
  padding .55rem .9rem
  radius 8px
  cursor pointer

.line
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  border 1px solid $line
  radius 10px
  padding .6rem .9rem
  margin .4rem 0
  background white

.line button
  bg transparent
  color $ink
  border 1px solid $line

.cart-foot
  font-size 1.1rem
  margin .75rem 0

.receipt
  border 1px solid $accent
  radius 10px
  padding 1rem
  background #ecf6f1
