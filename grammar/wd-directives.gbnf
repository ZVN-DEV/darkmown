# Darkmown .wd directive-line grammar (v2.1.0) — generated by src/grammar.js
# Constrains a directive line (or a { path | pipe } interpolation). Do not edit by hand.

root ::= directive | binding
directive ::= dir-include | dir-loop | dir-container | dir-if | dir-state | dir-store | dir-computed | dir-fetch | dir-effect | dir-every | dir-theme | dir-button | dir-form | dir-input | dir-textarea | dir-select | dir-checkbox | dir-radio | dir-submit | dir-bind | dir-slider | dir-video | dir-audio | dir-embed | dir-carousel

dir-loop ::= "@loop" sp operand sp "into" sp ident loop-clauses
dir-if ::= ":if" sp ( condition (sp joiner sp condition)* | path )
dir-button ::= ":button" sp dqstring sp "->" sp action-chain
dir-container ::= ":::" restofline

dir-include ::= "@include" restofline
dir-state ::= ":state" restofline
dir-store ::= ":store" restofline
dir-computed ::= ":computed" restofline
dir-fetch ::= ":fetch" restofline
dir-effect ::= ":effect" restofline
dir-every ::= ":every" restofline
dir-theme ::= ":theme" restofline
dir-form ::= ":form" restofline
dir-input ::= ":input" restofline
dir-textarea ::= ":textarea" restofline
dir-select ::= ":select" restofline
dir-checkbox ::= ":checkbox" restofline
dir-radio ::= ":radio" restofline
dir-submit ::= ":submit" restofline
dir-bind ::= ":bind" restofline
dir-slider ::= ":slider" restofline
dir-video ::= ":video" restofline
dir-audio ::= ":audio" restofline
dir-embed ::= ":embed" restofline
dir-carousel ::= ":carousel" restofline

loop-clauses ::= ( sp loop-clause )*
loop-clause ::= where-clause | "sort by" sp path ( sp ( "asc" | "desc" ) )? | "reverse" | "offset" sp number | "limit" sp number | "paginate" sp number | "sortable"
where-clause ::= "where" sp condition ( sp joiner sp condition )*
condition ::= operand sp op sp operand
op ::= "contains" | "==" | "!=" | ">=" | "<=" | ">" | "<"
joiner ::= "and" | "or"

action-chain ::= action ( wsopt ";" wsopt action )*
action ::= ident action-op
action-op ::= "++" | "--" | sp "+=" sp value | sp "-=" sp value | sp "=" sp value | sp "toggle" ( sp value )? | sp "append" sp value | sp "prepend" sp value | sp "remove" sp value | sp "clear" | sp "merge" sp ident | sp "delete" sp value | sp "reset" | sp "refetch"

binding ::= "{" wsopt path pipe-chain wsopt "}"
pipe-chain ::= ( wsopt "|" wsopt pipe ( ":" value )* )*
pipe ::= "money" | "number" | "percent" | "round" | "date" | "time" | "datetime" | "upper" | "lower" | "capitalize" | "truncate" | "trim" | "pluralize" | "default" | "sum" | "avg" | "min" | "max" | "count" | "join"

operand ::= path | dqstring | number
value ::= dqstring | number | path
ident ::= [a-zA-Z_$] [a-zA-Z0-9_$]*
path ::= [a-zA-Z0-9_$/.~-]+
number ::= [0-9]+
dqstring ::= "\"" [^"]* "\""
restofline ::= [^\n]*
sp ::= " "+
wsopt ::= " "*

