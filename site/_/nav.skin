tokens
  ink #171717
  paper #fbfaf7
  panel #ffffff
  line #dedbd3
  accent #16645a
  warm #a83f2a
  codebg #18221d
  codeink #ecf3ea
  radius 8px

/* No `tokens dark` here on purpose. The shared nav loads on EVERY page,
   including the older feature-demo pages (/reactive, /loops, …) whose bespoke
   component styles were never designed for a dark palette — flipping their
   shared tokens made buttons unreadable. Dark mode is therefore opt-in: it
   lives in base.skin, which only the refreshed pages and showcase apps include.
   On those pages base.skin's dark tokens drive the nav too, so it still goes
   dark there. */

.topnav
  display flex
  flex-wrap wrap
  gap .35rem 1.1rem
  align-items center
  padding .85rem 1.5rem
  max-width 100%
  box-sizing border-box
  border-bottom 1px solid $line
  background color-mix(in srgb, $paper 82%, transparent)
  backdrop-filter saturate(1.4) blur(10px)
  position sticky
  top 0
  z-index 20
  font-size .92rem

@media (max-width: 600px)
  .topnav
    padding .75rem 1rem
    gap .3rem .8rem

.topnav .brand
  font-weight 700
  font-size 1.08rem
  letter-spacing -.02em
  color $warm
  text-decoration none
  margin-right .5rem

.topnav .nav-links
  display inline-flex
  flex-wrap wrap
  gap .35rem 1.1rem
  align-items center

.topnav a
  color $accent
  text-decoration none

.topnav a:hover
  color $ink

.topnav .nav-gh
  margin-left auto
  color $ink
  font-weight 600

code
  background color-mix(in srgb, $paper 50%, $panel)
  border 1px solid $line
  padding .1rem .32rem
  radius 5px
  font-size .9em

h1 code, h2 code, h3 code
  font-size .85em

pre
  bg $codebg
  color $codeink
  padding 1.1rem 1.3rem
  margin 1.2rem 0
  radius $radius
  overflow-x auto
  line-height 1.6
  font-size .9rem
  box-shadow inset 0 0 0 1px rgba(255,255,255,.08)

pre code
  bg transparent
  border 0
  padding 0
  color inherit
  font-size 1em

table
  border-collapse collapse
  bg $panel
  margin 1rem 0

th
  text-align left
  border 1px solid $line
  padding .5rem .9rem
  background color-mix(in srgb, $paper 60%, $line)

td
  border 1px solid $line
  padding .5rem .9rem

blockquote
  margin 1.2rem 0
  padding .6rem 1.2rem
  border-left 3px solid $accent
  bg $panel
  radius $radius
