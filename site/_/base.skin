/* ===================================================================
   Darkmown design system — the refreshed brand foundation.
   Warm, literary, premium. Serif for prose, system sans for chrome,
   a refined mono for code. Ships zero JS; dark mode is OS-driven via
   `tokens dark` (a pure CSS media query — no flash, no toggle script).
   Every refreshed page and demo app includes this via /base.wd.
   =================================================================== */

tokens
  ink #1c1814
  ink-soft #4b4239
  muted #756a5d
  faint #9b9082
  paper #faf8f3
  paper-2 #f4f0e7
  sunk #efe9dc
  panel #ffffff
  line #e7e1d4
  line-soft #f0ebe0
  accent #0f6b5e
  accent-deep #0a4f45
  accent-soft #e3f0ec
  warm #b8462e
  warm-soft #f8eae3
  gold #b6822b
  code-bg #1b2420
  code-ink #e9efe7
  code-line #2c3b34
  code-fg #e9efe7
  code-keyword #d9a8e0
  code-string #97d892
  code-comment #859289
  code-function #88c4ee
  code-number #ecae78
  code-punctuation #c1ccc6
  ring #0f6b5e
  radius 12px
  radius-sm 8px
  radius-lg 20px
  field-bg #ffffff
  field-line #d9d2c4
  field-line-strong #c4baa8
  control-shadow 0 1px 2px rgba(28,24,20,.06)
  control-shadow-hover 0 6px 18px -8px rgba(28,24,20,.45)
  accent-press #094339
  on-accent #ffffff

tokens dark
  ink #ece6db
  ink-soft #c3bbab
  muted #9a9081
  faint #6f6657
  paper #14110d
  paper-2 #1a1612
  sunk #221d17
  panel #1e1913
  line #2f281f
  line-soft #261f18
  accent #5ccab4
  accent-deep #8fe0cf
  accent-soft #16302a
  warm #e88a6f
  warm-soft #2c1f18
  gold #d6a24e
  code-bg #100d0a
  code-ink #e4ebe2
  code-line #2a231b
  code-fg #e4ebe2
  code-keyword #e2b9e8
  code-string #a6e0a1
  code-comment #7c8983
  code-function #9bd0f4
  code-number #f2bb8a
  code-punctuation #b6c2bc
  ring #5ccab4
  field-bg #1a1612
  field-line #38301f
  field-line-strong #4a3f2c
  control-shadow 0 1px 2px rgba(0,0,0,.4)
  control-shadow-hover 0 8px 22px -10px rgba(0,0,0,.7)
  accent-press #b6ecdc
  on-accent #0c1310

/* ── Reset & base ───────────────────────────────────────────────── */

*
  box-sizing border-box

page
  margin 0
  font-family ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, Cambria, serif
  font-size 18px
  line-height 1.65
  color $ink
  bg $paper
  -webkit-font-smoothing antialiased
  text-rendering optimizeLegibility

::selection
  bg $accent-soft
  color $accent-deep

/* ── Typography ─────────────────────────────────────────────────── */

h1, h2, h3, h4
  line-height 1.1
  letter-spacing -.012em
  color $ink
  font-weight 600

h1
  font-size clamp(2.5rem, 6vw, 4.5rem)
  letter-spacing -.025em
  margin .2em 0 .35em

h2
  font-size clamp(1.6rem, 3vw, 2.25rem)
  margin 2.4em 0 .6em

h3
  font-size 1.3rem
  margin 1.8em 0 .4em

p
  margin 1em 0
  max-width 68ch

a
  color $accent
  text-underline-offset 2px
  text-decoration-thickness 1px

a:hover
  color $accent-deep

strong
  font-weight 650
  color $ink

hr
  border 0
  border-top 1px solid $line
  margin 3rem 0

small, .small
  font-size .82rem
  color $muted

/* Chrome (nav, buttons, labels, badges) leans on a clean sans for a
   modern editorial contrast against the serif prose. */
.topnav, .btn, .eyebrow, .pill, .tag, .badge, .kbd, .sitefooter, .source-reveal summary
  font-family system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif

/* ── Layout ─────────────────────────────────────────────────────── */

main
  max-width 940px
  margin 0 auto
  padding 0 1.5rem 5rem

.wide
  max-width 1140px

.eyebrow
  display inline-block
  text-transform uppercase
  letter-spacing .14em
  font-size .74rem
  font-weight 600
  color $accent
  margin 0 0 .35rem

/* ── Buttons ────────────────────────────────────────────────────────
   Two ways to get a button, ONE consistent look:
   1. The `.btn` class (for link-styled buttons: <a class="btn">).
   2. A bare <button> — what the `:button`/`:submit` directives emit with
      no class. Both share the same sizing, states, and tokens so a demo,
      a scaffold, or a docs page looks designed without per-page styling.
   The bare-button default is the ACCENT (filled) treatment, because a
   directive button is almost always the page's primary action. Opt down
   to a quieter look with class="secondary" / class="ghost".
   ─────────────────────────────────────────────────────────────────── */

/* Shared geometry + motion for every button-shaped thing. One-line comma
   selector (multi-line comma lists silently drop all but the last). */
.btn, button, button[data-wd-action], button[data-wd-actions], [type=submit], [type=button], [type=reset]
  display inline-flex
  align-items center
  justify-content center
  gap .5rem
  margin .4rem .5rem .4rem 0
  padding .62rem 1.15rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
  font-size .94rem
  font-weight 560
  line-height 1.15
  letter-spacing -.005em
  color $ink
  bg $panel
  border 1px solid $line
  radius 999px
  text-decoration none
  cursor pointer
  -webkit-appearance none
  appearance none
  transition transform .14s cubic-bezier(.2,.7,.3,1), box-shadow .14s ease, background .14s ease, border-color .14s ease, color .14s ease

/* The filled accent default — applies to bare directive buttons and to
   the opt-in `.btn.primary` / `.btn.warm` link variants. One-line list. */
button, button[data-wd-action], button[data-wd-actions], [type=submit], .btn.primary
  bg $accent
  color $on-accent
  border-color $accent
  box-shadow $control-shadow

button:hover, button[data-wd-action]:hover, button[data-wd-actions]:hover, [type=submit]:hover, .btn.primary:hover
  bg $accent-deep
  border-color $accent-deep
  color $on-accent
  transform translateY(-1px)
  box-shadow $control-shadow-hover

button:active, button[data-wd-action]:active, button[data-wd-actions]:active, [type=submit]:active, .btn.primary:active
  bg $accent-press
  border-color $accent-press
  transform translateY(0)
  box-shadow $control-shadow

/* Visible keyboard focus on every interactive control — accessibility. */
.btn:focus-visible, button:focus-visible, [type=submit]:focus-visible, [type=button]:focus-visible, [type=reset]:focus-visible
  outline 2px solid $ring
  outline-offset 2px

/* Skip-to-content link (emitted by the page shell) — themed reveal on focus. */
.wd-skip-link:focus
  bg $accent
  color $on-accent
  border-radius 0 0 $radius-sm 0
  outline 2px solid $ring
  outline-offset 2px

button:disabled, [type=submit]:disabled, .btn[aria-disabled=true], [type=button]:disabled
  opacity .5
  cursor not-allowed
  box-shadow none
  transform none

/* Quieter, neutral button — a secondary/cancel action. One-line list. */
.btn, button.secondary, button.ghost, .btn.secondary, .btn.ghost
  bg $panel
  color $ink
  border-color $line

.btn:hover
  transform translateY(-1px)
  box-shadow $control-shadow-hover

button.secondary:hover, .btn.secondary:hover
  bg $sunk
  border-color $line
  color $ink
  transform translateY(-1px)
  box-shadow $control-shadow-hover

button.ghost, .btn.ghost
  bg transparent
  border-color transparent
  box-shadow none

button.ghost:hover, .btn.ghost:hover
  bg $sunk
  box-shadow none
  transform none

.btn.warm
  bg $warm
  color #fff
  border-color $warm

.btn.warm:hover
  bg $warm
  color #fff

/* ── Form controls ──────────────────────────────────────────────────
   `:input`/`:bind`/`:textarea`/`:select` emit bare <input>/<textarea>/
   <select> — style them here so forms look designed by default. ─────── */

input, textarea, select
  font-family system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif
  font-size .95rem
  line-height 1.4
  color $ink
  bg $field-bg
  border 1px solid $field-line
  radius $radius-sm
  padding .58rem .8rem
  margin .35rem 0
  width 100%
  max-width 28rem
  -webkit-appearance none
  appearance none
  transition border-color .14s ease, box-shadow .14s ease, background .14s ease

input::placeholder, textarea::placeholder
  color $faint

input:hover, textarea:hover, select:hover
  border-color $field-line-strong

input:focus-visible, textarea:focus-visible, select:focus-visible
  outline none
  border-color $accent
  box-shadow 0 0 0 3px $accent-soft

input:disabled, textarea:disabled, select:disabled
  opacity .55
  cursor not-allowed
  bg $sunk

textarea
  min-height 6.5rem
  resize vertical

/* Native select chevron (the appearance reset hides the default arrow). */
select
  background-image url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%23756a5d' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E")
  background-repeat no-repeat
  background-position right .75rem center
  padding-right 2.25rem
  cursor pointer

/* Checkbox / radio — accent-tinted, comfortable hit target. The directive
   emits <label><input type=checkbox|radio> Text</label> in .wd-checkboxes /
   .wd-radios groups. One-line comma list. */
.wd-checkboxes, .wd-radios
  display flex
  flex-direction column
  gap .55rem
  margin .5rem 0

.wd-checkboxes label, .wd-radios label
  display flex
  align-items center
  gap .55rem
  cursor pointer

[type=checkbox], [type=radio]
  width 1.1rem
  height 1.1rem
  min-width 1.1rem
  margin 0
  max-width none
  padding 0
  accent-color $accent
  cursor pointer

[type=checkbox]:focus-visible, [type=radio]:focus-visible
  outline 2px solid $ring
  outline-offset 2px

label
  font-size .95rem
  color $ink-soft

/* The range slider (`:slider`) — tint the track to the brand accent. */
[type=range]
  accent-color $accent
  cursor pointer
  padding 0

/* Framework control buttons (`:carousel` injects these at runtime). They
   must NOT inherit the big accent pill above — reset them to a compact,
   neutral round control. Page skins can still override. One-line lists. */
.wd-carousel-prev, .wd-carousel-next
  width 2.25rem
  height 2.25rem
  padding 0
  margin 0
  bg $panel
  color $ink
  border 1px solid $line
  radius 999px
  box-shadow $control-shadow

.wd-carousel-prev:hover, .wd-carousel-next:hover
  bg $panel
  border-color $accent
  color $accent
  transform none
  box-shadow $control-shadow-hover

.wd-carousel-dot
  width .6rem
  height .6rem
  padding 0
  margin 0
  border 0
  radius 999px
  bg $line
  box-shadow none

.wd-carousel-dot:hover
  bg $faint
  transform none
  box-shadow none

.wd-carousel-dot[aria-current=true]
  bg $accent

/* ── Cards & surfaces ───────────────────────────────────────────── */

.card
  bg $panel
  border 1px solid $line
  radius $radius
  padding 1.4rem
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.grid
  display grid
  gap 1.1rem

.grid.cols-2
  grid-template-columns repeat(2, 1fr)

.grid.cols-3
  grid-template-columns repeat(3, 1fr)

.grid.auto
  grid-template-columns repeat(auto-fit, minmax(240px, 1fr))

@media (max-width: 760px)
  .grid.cols-2, .grid.cols-3
    grid-template-columns 1fr

/* ── Pills, tags, badges ────────────────────────────────────────── */

.pill, .tag
  display inline-flex
  align-items center
  gap .35rem
  font-size .72rem
  font-weight 600
  text-transform uppercase
  letter-spacing .06em
  padding .28rem .6rem
  radius 999px

.pill
  bg $accent-soft
  color $accent-deep

.tag
  bg $sunk
  color $muted

.kbd
  font-family ui-monospace, "SF Mono", Menlo, monospace
  font-size .8rem
  padding .15rem .4rem
  radius 6px
  bg $panel
  border 1px solid $line
  color $ink-soft

/* ── Callout (the demo :note directive renders <aside class="note">) ─ */

.note, .callout
  margin 1.6rem 0
  padding 1rem 1.25rem
  border 1px solid $line
  border-left 3px solid $accent
  bg $panel
  radius $radius-sm
  color $ink-soft
  font-size .96rem

/* ── Code ───────────────────────────────────────────────────────── */

code
  font-family ui-monospace, "SF Mono", Menlo, Consolas, monospace
  font-size .88em
  bg $sunk
  color $accent-deep
  padding .12rem .36rem
  radius 6px
  /* An inline token that wraps (`unsafe-eval` breaks at its hyphen) otherwise
     leaves a half-open pill on each line: padding and rounding on the outer
     edges only. `clone` gives every fragment the full box, so a wrapped token
     reads as one styled run instead of a rendering artifact. Wrapping itself
     is left alone on purpose: some inline tokens on this site run to 70+
     characters, and `nowrap` would overflow the viewport on a phone. */
  box-decoration-break clone
  -webkit-box-decoration-break clone

h1 code, h2 code, h3 code
  font-size .82em

pre
  bg $code-bg
  color $code-ink
  padding 1.2rem 1.35rem
  margin 1.5rem 0
  radius $radius
  overflow-x auto
  line-height 1.62
  font-size .87rem
  box-shadow inset 0 0 0 1px $code-line

pre code
  bg transparent
  color inherit
  padding 0
  font-size 1em

/* ── Tables ─────────────────────────────────────────────────────── */

table
  border-collapse collapse
  width 100%
  margin 1.5rem 0
  font-size .95rem

th
  text-align left
  padding .6rem .9rem
  border-bottom 2px solid $line
  color $muted
  font-weight 600
  font-size .82rem
  text-transform uppercase
  letter-spacing .04em

td
  padding .6rem .9rem
  border-bottom 1px solid $line-soft

blockquote
  margin 1.6rem 0
  padding .6rem 1.3rem
  border-left 3px solid $accent
  color $ink-soft
  font-style italic

/* ── "View source" reveal — the two-beat trick: a slick app, then the
     Markdown it's made of. Wrap a fenced ```wd block in <details>. ── */

.source-reveal
  margin 1.5rem 0
  border 1px solid $line
  radius $radius
  bg $panel
  overflow hidden

.source-reveal summary
  cursor pointer
  padding .85rem 1.1rem
  font-size .9rem
  font-weight 600
  color $accent-deep
  list-style none
  display flex
  align-items center
  gap .5rem

.source-reveal summary::-webkit-details-marker
  display none

.source-reveal summary::before
  content "›"
  font-size 1.1rem
  transition transform .15s ease

.source-reveal[open] summary::before
  transform rotate(90deg)

.source-reveal pre
  margin 0
  radius 0

/* ── Motion preference ──────────────────────────────────────────────
   Honour users who ask for less motion: drop the button lift/transition.
   (@media must be indented in a .skin — its rules wrap automatically.) ── */

@media (prefers-reduced-motion: reduce)
  .btn, button, [type=submit], [type=button], input, textarea, select
    transition none
  .btn:hover, button:hover, [type=submit]:hover
    transform none

/* ── Footer ─────────────────────────────────────────────────────── */

.sitefooter
  border-top 1px solid $line
  margin-top 4rem
  padding 2.5rem 1.5rem
  color $muted
  font-size .9rem

.sitefooter .foot-inner
  max-width 940px
  margin 0 auto
  display flex
  flex-wrap wrap
  gap 1rem 2rem
  align-items center
  justify-content space-between

.sitefooter a
  color $muted
  text-decoration none
  margin-right 1.1rem

.sitefooter a:hover
  color $accent
