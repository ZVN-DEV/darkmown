/* Folio cart / checkout page — thin layer over style.skin and /base.wd.
   Holds the line-item rows, the two-column cart layout, and the checkout
   form + receipt styling. */

/* ── Two-column: line items | checkout panel ────────────────────── */

.app-folio .cart-grid
  display grid
  grid-template-columns 1.3fr 1fr
  gap 2rem
  align-items start
  margin-top 2rem

.app-folio .cart-lines h2, .app-folio .checkout-panel h2
  margin-top 0

@media (max-width: 860px)
  .app-folio .cart-grid
    grid-template-columns 1fr
    gap 2rem

/* ── A basket line — same compact card treatment as the catalog ──── */

.app-folio .line
  display flex
  align-items center
  gap .9rem
  padding .85rem 1rem
  margin .65rem 0
  border 1px solid $line
  radius $radius
  bg $panel
  box-shadow 0 1px 2px rgba(28,24,20,.04)
  transition border-color .14s ease, box-shadow .14s ease

.app-folio .line:hover
  border-color var(--brand)
  box-shadow 0 10px 24px -18px rgba(28,24,20,.45)

/* Prose inside the line containers renders as <p>; strip its margins so
   the compact row holds (the chip is a tight 46px box). */
.app-folio .line .line-emoji p, .app-folio .line .line-name p, .app-folio .line .line-cat p, .app-folio .line .line-price p
  margin 0
  max-width none

/* The emoji chip — matches the catalog card chip exactly. */
.app-folio .line .line-emoji
  font-size 1.55rem
  line-height 1
  width 46px
  height 46px
  display flex
  align-items center
  justify-content center
  flex-shrink 0
  radius 14px
  background var(--brand-tint)
  border 1px solid $line-soft

.app-folio .line .line-body
  flex 1
  min-width 0

.app-folio .line .line-name
  font-size 1.08rem
  font-weight 600
  letter-spacing -.01em
  line-height 1.2
  margin 0

.app-folio .line .line-cat
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .68rem
  font-weight 600
  text-transform uppercase
  letter-spacing .08em
  color $muted
  margin .2rem 0 0

.app-folio .line .line-price
  font-size 1.15rem
  font-weight 650
  letter-spacing -.02em
  color $ink
  margin 0
  flex-shrink 0

.app-folio .line button[data-wd-action]
  border 1px solid $line
  margin 0
  flex-shrink 0
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .78rem
  font-weight 600
  padding .42rem .8rem
  radius 999px
  bg $panel
  color $muted
  cursor pointer
  transition color .14s ease, border-color .14s ease, background .14s ease

.app-folio .line button[data-wd-action]:hover
  color var(--brand)
  border-color var(--brand)
  background var(--brand-soft)

/* Empty basket card */
.app-folio .cart-blank
  padding 2.25rem 1.5rem
  text-align center
  border 1px dashed $line
  radius $radius
  bg $paper-2
  color $muted

.app-folio .cart-blank a
  color var(--brand)
  font-weight 600

/* Clear-basket action row */
.app-folio .cart-actions
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap .75rem
  margin-top 1.25rem
  padding-top 1.1rem
  border-top 1px solid $line-soft
  font-size .9rem
  color $muted

.app-folio .cart-actions button[data-wd-action]
  border 1px solid $line
  margin 0
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .82rem
  font-weight 600
  padding .55rem 1rem
  radius 999px
  bg $panel
  color $ink-soft
  cursor pointer
  transition color .14s ease, border-color .14s ease

.app-folio .cart-actions button[data-wd-action]:hover
  color var(--brand)
  border-color var(--brand)

/* ── Checkout panel ─────────────────────────────────────────────── */

.app-folio .checkout-panel
  position sticky
  top 1.25rem
  border 1px solid $line
  radius $radius
  bg $panel
  padding 1.5rem 1.5rem 1.65rem
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.app-folio .checkout-panel p
  font-size .92rem
  color $ink-soft

.app-folio .checkout-panel form
  display flex
  flex-direction column
  gap .75rem
  margin 1.25rem 0 0

.app-folio .checkout-panel input, .app-folio .checkout-panel select
  width 100%
  box-sizing border-box
  font-family inherit
  font-size 1rem
  padding .75rem .9rem
  border 1px solid $line
  radius $radius-sm
  bg $paper
  color $ink
  margin 0
  transition border-color .15s ease, box-shadow .15s ease

.app-folio .checkout-panel input:focus, .app-folio .checkout-panel select:focus
  outline none
  border-color var(--brand)
  box-shadow 0 0 0 3px var(--brand-soft)

.app-folio .checkout-panel input::placeholder
  color $faint

.app-folio .checkout-panel button[type="submit"]
  border 0
  margin .45rem 0 0
  width 100%
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size 1rem
  font-weight 600
  letter-spacing .01em
  padding .9rem 1rem
  radius 999px
  bg var(--brand)
  color #fff
  cursor pointer
  transition background .14s ease, transform .12s ease, box-shadow .12s ease

.app-folio .checkout-panel button[type="submit"]:hover
  bg var(--brand-deep)
  transform translateY(-1px)
  box-shadow 0 10px 20px -8px rgba(184,70,46,.5)

.app-folio .checkout-panel button[type="submit"]:active
  transform translateY(0)

.app-folio .checkout-hint
  margin 1.1rem 0 0
  padding-top 1rem
  border-top 1px solid $line-soft
  font-size .85rem
  color $muted
  font-style italic

/* ── Receipt ────────────────────────────────────────────────────── */

.app-folio .receipt
  margin 1.25rem 0 0
  padding 1.2rem 1.3rem
  border 1px solid var(--brand)
  border-left 3px solid var(--brand)
  radius $radius
  background var(--brand-soft)

.app-folio .receipt strong
  color var(--brand-deep)

.app-folio .receipt p
  color $ink-soft

.app-folio .receipt .receipt-stamp
  margin .6rem 0 0
  font-family ui-monospace, "SF Mono", Menlo, monospace
  font-size .76rem
  color $muted

.app-folio .receipt-error
  margin 1rem 0 0
  padding 1rem 1.2rem
  border 1px solid $line
  border-left 3px solid $warm
  radius $radius-sm
  background $warm-soft
  color $ink-soft
  font-size .9rem

/* ── Order summary — live subtotal/tax/total via :computed sum() + | money ── */
.app-folio .order-summary
  margin-top 1.25rem
  padding 1.1rem 1.2rem
  border 1px solid $line-soft
  radius 14px
  bg $panel

.app-folio .order-summary h3
  margin 0 0 .75rem
  font-size .78rem
  font-weight 700
  letter-spacing .08em
  text-transform uppercase
  color $muted

.app-folio .sum-row
  display flex
  align-items baseline
  justify-content space-between
  gap 1rem
  font-size .92rem
  color $ink-soft
  padding .3rem 0

.app-folio .sum-row p
  margin 0

.app-folio .sum-val
  font-variant-numeric tabular-nums
  color $ink

.app-folio .sum-total
  margin-top .35rem
  padding-top .7rem
  border-top 1px solid $line-soft
  font-size 1.05rem
  color $ink

.app-folio .order-summary button[data-wd-action]
  margin-top 1rem
  width 100%
  border 1px solid $line
  font-size .82rem
  font-weight 600
  padding .6rem 1rem
  radius 999px
  bg transparent
  color $ink-soft
  cursor pointer
  transition color .14s ease, border-color .14s ease

.app-folio .order-summary button[data-wd-action]:hover
  color $ink
  border-color $ink-soft
