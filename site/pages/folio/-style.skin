/* ===================================================================
   Folio — a boutique storefront. Warm editorial luxe.

   Sits on top of /base.wd (tokens, type, dark mode, .card/.btn/.tag).
   The DISTINCT identity: a refined terracotta accent, a tight 2-column
   product grid beside a sticky cart rail, compact uniform cards with a
   soft emoji chip, and a filled brand "Add" button.
   Shared by /folio/ and /folio/cart/ via `@include ./style.wd`.
   =================================================================== */

/* The brand accent — scoped to the app wrapper so it never leaks into
   the rest of the site. Dark mode lifts it to a warmer, brighter clay. */
.app-folio
  --brand #b8462e
  --brand-deep #97331f
  --brand-soft #f8ece5
  --brand-tint #fbf3ee
  --shelf #fcf9f4

@media (prefers-color-scheme: dark)
  .app-folio
    --brand #e88a6f
    --brand-deep #f2a78f
    --brand-soft #2c1d16
    --brand-tint #221710
    --shelf #18130e

.app-folio
  padding-top 1rem

/* ── Storefront header / hero ───────────────────────────────────── */

.shop-head
  display flex
  flex-wrap wrap
  align-items flex-end
  justify-content space-between
  gap 1.25rem 2rem
  padding 2.25rem 0 1.75rem
  border-bottom 1px solid $line

.shop-mark
  max-width 44ch

.shop-eyebrow
  display inline-block
  text-transform uppercase
  letter-spacing .22em
  font-size .72rem
  font-weight 600
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  color var(--brand)
  margin 0 0 .55rem

.shop-name
  font-size clamp(2.75rem, 7vw, 4.75rem)
  line-height .92
  letter-spacing -.03em
  margin 0
  font-weight 600

.shop-name em
  font-style italic
  color var(--brand)

.shop-tagline
  font-size 1.08rem
  color $ink-soft
  margin .85rem 0 0
  max-width 42ch

/* ── Layout: catalog + sticky cart rail ─────────────────────────── */

.shop-layout
  display grid
  grid-template-columns 1fr 300px
  gap 2rem
  align-items start
  margin-top 2rem

.shop-main
  min-width 0

@media (max-width: 900px)
  .shop-layout
    grid-template-columns 1fr
    gap 1.5rem

/* ── Search field (a :bind input) ───────────────────────────────── */

.shop-search input[data-wd-bind-input]
  width 100%
  box-sizing border-box
  font-family inherit
  font-size 1.02rem
  padding .8rem 1.1rem
  border 1px solid $line
  radius 999px
  bg $panel
  color $ink
  margin .1rem 0 .35rem
  transition border-color .15s ease, box-shadow .15s ease

.shop-search input[data-wd-bind-input]:focus
  outline none
  border-color var(--brand)
  box-shadow 0 0 0 3px var(--brand-soft)

.shop-search input[data-wd-bind-input]::placeholder
  color $faint

.shop-hint
  font-size .82rem
  color $muted
  font-style italic
  margin .1rem 0 0

/* ── Catalog grid ────────────────────────────────────────────────
   The reactive @loop renders rows into a `<div data-wd-loop-out>`, so the
   grid lives on that out container (its direct children are the cards). */

.catalog
  margin 1.5rem 0 0

.catalog [data-wd-loop-out]
  display grid
  grid-template-columns repeat(2, 1fr)
  gap 1rem

@media (max-width: 620px)
  .catalog [data-wd-loop-out]
    grid-template-columns 1fr

/* ── Product card ─────────────────────────────────────────────────
   Compact and uniform: a small emoji chip top-left, the name + tag,
   a one-line blurb, then a price/Add footer pinned to the bottom. */

.product
  position relative
  display flex
  flex-direction column
  gap .7rem
  padding 1.1rem 1.15rem 1.15rem
  height 100%
  box-sizing border-box
  border 1px solid $line
  radius $radius
  bg $panel
  box-shadow 0 1px 2px rgba(28,24,20,.04)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease

.product:hover
  transform translateY(-2px)
  border-color var(--brand)
  box-shadow 0 16px 34px -22px rgba(28,24,20,.45)

/* Prose inside the card containers renders as <p>; strip its margins so
   the compact layout holds (the chip is a tight 48px box). */
.product .chip p, .product .pname p, .product .tag p, .product .blurb p, .product .price p
  margin 0
  max-width none

/* The emoji chip — a small soft-tinted rounded square holding the emoji. */
.product .chip
  display flex
  align-items center
  justify-content center
  width 48px
  height 48px
  font-size 1.65rem
  line-height 1
  radius 14px
  background var(--brand-tint)
  border 1px solid $line-soft
  flex-shrink 0

.product .body
  display flex
  flex-direction column
  gap .4rem
  flex 1
  min-width 0

.product .pname
  font-size 1.18rem
  line-height 1.18
  letter-spacing -.015em
  margin 0
  font-weight 600

.product .body .tag
  align-self flex-start
  margin 0
  background var(--brand-soft)
  color var(--brand-deep)

.product .blurb
  font-size .86rem
  color $ink-soft
  line-height 1.45
  margin .1rem 0 0
  flex 1
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  overflow hidden

.product .foot
  display flex
  align-items center
  justify-content space-between
  gap .6rem
  margin-top .55rem
  padding-top .8rem
  border-top 1px solid $line-soft

.product .price
  font-size 1.3rem
  font-weight 650
  letter-spacing -.02em
  color $ink
  margin 0

/* The "Add" button — filled brand terracotta, white, fully rounded.
   The `:button` directive emits a bare <button data-wd-action>, so we
   target it by attribute (same pattern as the cart's remove button). */
.product .foot button[data-wd-action]
  border 0
  margin 0
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .85rem
  font-weight 600
  letter-spacing .01em
  padding .5rem 1.1rem
  radius 999px
  bg var(--brand)
  color #fff
  cursor pointer
  flex-shrink 0
  transition background .14s ease, transform .12s ease, box-shadow .12s ease

.product .foot button[data-wd-action]:hover
  bg var(--brand-deep)
  transform translateY(-1px)
  box-shadow 0 8px 16px -8px rgba(184,70,46,.5)

.product .foot button[data-wd-action]:active
  transform translateY(0)

/* Empty / no-matches state — spans the whole grid row. */
.catalog-empty
  grid-column 1 / -1
  padding 2.25rem 1.5rem
  text-align center
  border 1px dashed $line
  radius $radius
  bg $paper-2
  color $muted

.catalog-empty p
  margin .3rem auto
  max-width none

/* ── Sticky cart rail (catalog page) — same card treatment ──────── */

.cart-rail
  position sticky
  top 1.25rem
  border 1px solid $line
  radius $radius
  bg $panel
  padding 1.25rem 1.25rem 1.35rem
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.cart-rail .rail-eyebrow
  display flex
  align-items center
  justify-content space-between
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .7rem
  font-weight 600
  text-transform uppercase
  letter-spacing .12em
  color $muted
  margin 0 0 .15rem

.cart-rail .rail-count
  font-size 2.85rem
  line-height 1
  letter-spacing -.03em
  color var(--brand)
  margin .1rem 0 0
  font-weight 650

.cart-rail .rail-sub
  font-size .88rem
  color $ink-soft
  margin .5rem 0 1rem

.cart-rail .rail-link
  display flex
  align-items center
  justify-content center
  gap .4rem
  width 100%
  box-sizing border-box
  margin 0
  padding .75rem 1rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .92rem
  font-weight 600
  text-decoration none
  radius 999px
  bg var(--brand)
  color #fff
  border 1px solid var(--brand)
  transition background .14s ease, transform .12s ease, box-shadow .12s ease

.cart-rail .rail-link:hover
  bg var(--brand-deep)
  color #fff
  transform translateY(-1px)
  box-shadow 0 8px 16px -8px rgba(184,70,46,.5)

.cart-rail .rail-note
  margin 1rem 0 0
  border-top 1px solid $line-soft
  padding-top .9rem
  font-size .8rem
  color $muted
  font-style italic
  line-height 1.5

/* ── Persistence ribbon ─────────────────────────────────────────── */

.persist-note
  display flex
  gap .7rem
  align-items flex-start
  margin 1.75rem 0 0
  padding 1rem 1.2rem
  border 1px solid $line
  border-left 3px solid var(--brand)
  radius $radius-sm
  bg var(--brand-soft)
  color $ink-soft
  font-size .9rem

.persist-note .dot
  font-size 1.05rem
  line-height 1.5
  color var(--brand)

/* ── Footer cross-link strip ────────────────────────────────────── */

.folio-foot
  display flex
  flex-wrap wrap
  align-items center
  justify-content space-between
  gap 1rem
  margin 3rem 0 0
  padding-top 1.5rem
  border-top 1px solid $line
  font-size .92rem
  color $muted

.folio-foot a
  color var(--brand)
  font-weight 600
  text-decoration none

.folio-foot a:hover
  color var(--brand-deep)
  text-decoration underline
