/* ===================================================================
   Folio — a boutique storefront. Warm editorial luxe.

   Sits on top of /base.wd (tokens, type, dark mode, .card/.btn/.tag).
   The DISTINCT identity: a refined terracotta accent, generous
   whitespace, large serif product names, emoji-forward neutral cards.
   Shared by /folio/ and /folio/cart/ via `@include ./style.wd`.
   =================================================================== */

/* The brand accent — scoped to the app wrapper so it never leaks into
   the rest of the site. Dark mode lifts it to a warmer, brighter clay. */
.app-folio
  --brand #b8462e
  --brand-deep #97331f
  --brand-soft #f8ece5
  --shelf #fcf9f4

@media (prefers-color-scheme: dark)
  .app-folio
    --brand #e88a6f
    --brand-deep #f2a78f
    --brand-soft #2c1d16
    --shelf #18130e

.app-folio
  padding-top 1rem

/* ── Storefront header / hero ───────────────────────────────────── */

.shop-head
  display flex
  flex-wrap wrap
  align-items flex-end
  justify-content space-between
  gap 1.5rem 2rem
  padding 2.5rem 0 2rem
  border-bottom 1px solid $line

.shop-mark
  max-width 40ch

.shop-eyebrow
  display inline-block
  text-transform uppercase
  letter-spacing .22em
  font-size .72rem
  font-weight 600
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  color var(--brand)
  margin 0 0 .6rem

.shop-name
  font-size clamp(3rem, 8vw, 5.5rem)
  line-height .92
  letter-spacing -.03em
  margin 0
  font-weight 600

.shop-name em
  font-style italic
  color var(--brand)

.shop-tagline
  font-size 1.15rem
  color $ink-soft
  margin 1rem 0 0
  max-width 38ch

/* ── Layout: catalog + sticky cart rail ─────────────────────────── */

.shop-layout
  display grid
  grid-template-columns 1fr 320px
  gap 2.5rem
  align-items start
  margin-top 2.25rem

.shop-main
  min-width 0

@media (max-width: 900px)
  .shop-layout
    grid-template-columns 1fr
    gap 1.75rem

/* ── Search field (a :bind input) ───────────────────────────────── */

.shop-search input[data-wd-bind-input]
  width 100%
  box-sizing border-box
  font-family inherit
  font-size 1.05rem
  padding .85rem 1.1rem
  border 1px solid $line
  radius 999px
  bg $panel
  color $ink
  margin .25rem 0 .35rem
  transition border-color .15s ease, box-shadow .15s ease

.shop-search input[data-wd-bind-input]:focus
  outline none
  border-color var(--brand)
  box-shadow 0 0 0 3px var(--brand-soft)

.shop-search input[data-wd-bind-input]::placeholder
  color $faint

.shop-hint
  font-size .85rem
  color $muted
  font-style italic
  margin .1rem 0 0

/* ── Catalog grid ───────────────────────────────────────────────── */

.catalog
  display grid
  grid-template-columns repeat(auto-fill, minmax(230px, 1fr))
  gap 1.25rem
  margin 1.75rem 0 0
  padding 0
  list-style none

@media (max-width: 520px)
  .catalog
    grid-template-columns 1fr

/* ── Product card ───────────────────────────────────────────────── */

.product
  position relative
  display flex
  flex-direction column
  padding 0
  overflow hidden
  border 1px solid $line
  radius $radius-lg
  bg $panel
  box-shadow 0 1px 2px rgba(28,24,20,.04)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease

.product:hover
  transform translateY(-3px)
  border-color var(--brand)
  box-shadow 0 18px 38px -22px rgba(28,24,20,.5)

/* The emoji "shelf" — a soft neutral plinth the product sits on. */
.product .shelf
  display flex
  align-items center
  justify-content center
  font-size 3.6rem
  line-height 1
  height 8.5rem
  margin 0
  background linear-gradient(160deg, var(--shelf), $paper-2)
  border-bottom 1px solid $line-soft

.product .body
  display flex
  flex-direction column
  gap .55rem
  padding 1.15rem 1.25rem 1.3rem
  flex 1

.product .body .tag
  align-self flex-start
  margin 0
  background var(--brand-soft)
  color var(--brand-deep)

.product .pname
  font-size 1.5rem
  line-height 1.1
  letter-spacing -.015em
  margin 0
  font-weight 600

.product .blurb
  font-size .92rem
  color $ink-soft
  line-height 1.5
  margin 0
  flex 1

.product .foot
  display flex
  align-items center
  justify-content space-between
  gap .75rem
  margin-top .35rem

.product .price
  font-size 1.35rem
  font-weight 600
  letter-spacing -.02em
  color $ink
  margin 0

.product .add
  border 0
  margin 0
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .85rem
  font-weight 600
  letter-spacing .01em
  padding .55rem 1rem
  radius 999px
  bg var(--brand)
  color #fff
  cursor pointer
  flex-shrink 0
  transition background .14s ease, transform .12s ease

.product .add:hover
  bg var(--brand-deep)
  transform translateY(-1px)

.product .add:active
  transform translateY(0)

/* Empty / no-matches state inside the catalog */
.catalog-empty
  grid-column 1 / -1
  padding 2.5rem 1.5rem
  text-align center
  border 1px dashed $line
  radius $radius-lg
  bg $paper-2
  color $muted

.catalog-empty p
  margin .3rem auto
  max-width none

/* ── Sticky cart rail (catalog page) ────────────────────────────── */

.cart-rail
  position sticky
  top 1.25rem
  border 1px solid $line
  radius $radius-lg
  bg $panel
  padding 1.4rem 1.4rem 1.5rem
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.cart-rail .rail-eyebrow
  display flex
  align-items center
  justify-content space-between
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .72rem
  font-weight 600
  text-transform uppercase
  letter-spacing .12em
  color $muted
  margin 0 0 .25rem

.cart-rail .rail-count
  font-size 3rem
  line-height 1
  letter-spacing -.03em
  color var(--brand)
  margin .1rem 0 0
  font-weight 600

.cart-rail .rail-sub
  font-size .92rem
  color $ink-soft
  margin .5rem 0 1.1rem

.cart-rail .rail-link
  display flex
  align-items center
  justify-content center
  gap .4rem
  width 100%
  box-sizing border-box
  margin 0
  padding .8rem 1rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .95rem
  font-weight 600
  text-decoration none
  radius 999px
  bg var(--brand)
  color #fff
  border 1px solid var(--brand)
  transition background .14s ease, transform .12s ease

.cart-rail .rail-link:hover
  bg var(--brand-deep)
  color #fff
  transform translateY(-1px)

.cart-rail .rail-note
  margin 1.1rem 0 0
  padding 0
  border 0
  border-top 1px solid $line-soft
  padding-top 1rem
  font-size .82rem
  color $muted
  font-style italic
  line-height 1.5

/* ── Persistence ribbon ─────────────────────────────────────────── */

.persist-note
  display flex
  gap .7rem
  align-items flex-start
  margin 1.75rem 0 0
  padding 1rem 1.2rem
  border 1px solid $line
  border-left 3px solid var(--brand)
  radius $radius-sm
  bg var(--brand-soft)
  color $ink-soft
  font-size .92rem

.persist-note .dot
  font-size 1.05rem
  line-height 1.5

/* ── Footer cross-link strip ────────────────────────────────────── */

.folio-foot
  display flex
  flex-wrap wrap
  align-items center
  justify-content space-between
  gap 1rem
  margin 3rem 0 0
  padding-top 1.5rem
  border-top 1px solid $line
  font-size .92rem
  color $muted

.folio-foot a
  color var(--brand)
  font-weight 600
  text-decoration none

.folio-foot a:hover
  color var(--brand-deep)
  text-decoration underline
