/* ===================================================================
   Pulse — a dark, glassy observability dashboard.
   Layers on /base.wd (tokens, type, components). Everything here is
   scoped under `.app-pulse` so the dashboard owns its own dark surface
   and cyan/mint accent without leaking into the rest of the site.
   Dark-first by design, but legible in light mode too.
   =================================================================== */

/* ── Accent + local dark surface (scoped, never global) ─────────────
   The dashboard paints its own deep panels so it reads "premium
   observability tool" even in OS light mode. Numbers go mono. */

.app-pulse
  --brand #18b89a
  --brand-dim #0e8d77
  --ok #2bd4a8
  --warn #f0b429
  --down #ff6b6b
  --surface #0d1117
  --surface-2 #131a23
  --surface-3 #1a232e
  --hair #243140
  --hair-soft #1b2531
  --txt #e7eef5
  --txt-soft #aab7c4
  --txt-mute #6b7a89
  --mono ui-monospace, "SF Mono", SFMono-Regular, "JetBrains Mono", Menlo, Consolas, monospace
  color $txt

@media (prefers-color-scheme: dark)
  .app-pulse
    --brand #2fe0c0
    --surface #0a0e14
    --surface-2 #10161f
    --surface-3 #161f2a

/* The wrapper itself becomes the dark canvas with a faint radial glow. */
.app-pulse
  background radial-gradient(1200px 600px at 80% -10%, rgba(47,224,192,.08), transparent 60%), $surface
  border 1px solid $hair
  border-radius 18px
  padding 2rem 2rem 2.5rem
  margin-top 1.5rem
  box-shadow 0 30px 80px -40px rgba(0,0,0,.7)

.app-pulse h1, .app-pulse h2, .app-pulse h3
  color $txt
  letter-spacing -.02em

.app-pulse h2
  font-size 1.25rem
  margin 2.4rem 0 1rem
  display flex
  align-items center
  gap .6rem

.app-pulse h2::before
  content ""
  width .55rem
  height .55rem
  border-radius 2px
  background $brand
  box-shadow 0 0 12px $brand
  flex-shrink 0

.app-pulse p
  color $txt-soft
  max-width 70ch

.app-pulse a
  color $brand

.app-pulse strong
  color $txt

.app-pulse code
  background $surface-3
  color $brand
  border 1px solid $hair

/* ── Masthead ───────────────────────────────────────────────────── */

.pulse-head
  display flex
  flex-wrap wrap
  align-items flex-end
  justify-content space-between
  gap 1rem
  padding-bottom 1.5rem
  border-bottom 1px solid $hair
  margin-bottom .5rem

.pulse-title
  display flex
  align-items center
  gap .8rem
  margin 0

.pulse-mark
  width 2.4rem
  height 2.4rem
  border-radius 12px
  background linear-gradient(145deg, $brand, $brand-dim)
  display inline-flex
  align-items center
  justify-content center
  font-size 1.3rem
  box-shadow 0 0 0 1px rgba(47,224,192,.4), 0 8px 24px -8px rgba(47,224,192,.5)
  flex-shrink 0

.pulse-name
  font-size 1.9rem
  font-weight 700
  letter-spacing -.03em
  line-height 1
  color $txt

.pulse-sub
  display block
  font-size .8rem
  letter-spacing .14em
  text-transform uppercase
  color $txt-mute
  margin-top .3rem
  font-family $mono

/* The live status line: a pulsing dot + monospace timestamp. */
.pulse-live
  display inline-flex
  align-items center
  gap .55rem
  font-family $mono
  font-size .82rem
  color $txt-soft
  padding .5rem .85rem
  background $surface-2
  border 1px solid $hair
  border-radius 999px

.pulse-live .dot
  width .5rem
  height .5rem
  border-radius 50%
  background $ok
  box-shadow 0 0 0 0 rgba(43,212,168,.55)
  animation pulse-beat 2s infinite

/* ── Toolbar (refresh / filter controls) ───────────────────────── */

.pulse-bar
  display flex
  flex-wrap wrap
  align-items center
  gap .6rem
  margin 1.25rem 0 .5rem

.app-pulse .btn
  background $surface-2
  color $txt
  border 1px solid $hair
  font-size .85rem
  padding .55rem 1rem
  box-shadow none

.app-pulse .btn:hover
  border-color $brand
  color $txt
  transform translateY(-1px)
  box-shadow 0 6px 18px -10px rgba(47,224,192,.6)

.app-pulse .btn.primary
  background linear-gradient(145deg, $brand, $brand-dim)
  color #04130f
  border-color transparent
  font-weight 650

.app-pulse .btn.primary:hover
  background $brand
  color #04130f

/* ── Stat cards (rollups) ───────────────────────────────────────── */

.pulse-stats
  display grid
  grid-template-columns repeat(4, 1fr)
  gap 1rem
  margin 1.25rem 0 .5rem

@media (max-width: 820px)
  .pulse-stats
    grid-template-columns 1fr 1fr

.stat
  background linear-gradient(180deg, $surface-2, $surface)
  border 1px solid $hair
  border-radius 14px
  padding 1.1rem 1.2rem
  position relative
  overflow hidden

.stat::after
  content ""
  position absolute
  inset 0 auto 0 0
  width 3px
  background $brand
  opacity .55

/* Label = the first <p><strong> the directive emits for `**Label**`. */
.stat > p
  margin 0

.stat > p:first-child
  font-size .72rem
  text-transform uppercase
  letter-spacing .1em
  color $txt-mute
  margin-bottom .55rem

.stat > p:first-child strong
  font-weight 600
  color $txt-mute

.stat .stat-value
  font-family $mono
  font-size 2rem
  font-weight 600
  letter-spacing -.02em
  color $txt
  line-height 1

.stat .stat-value p
  margin 0

/* Foot = the trailing caption paragraph after the value block. */
.stat > p:last-child
  margin-top .55rem
  font-size .76rem
  color $txt-soft
  font-family $mono
  line-height 1.4

.stat.is-ok::after
  background $ok
.stat.is-warn::after
  background $warn
.stat.is-down::after
  background $down

.stat.is-ok .stat-value
  color $ok
.stat.is-warn .stat-value
  color $warn
.stat.is-down .stat-value
  color $down

/* ── Lifecycle states (loading / error / empty) ─────────────────── */

.pulse-state
  display flex
  align-items center
  gap .9rem
  padding 1.1rem 1.25rem
  border-radius 14px
  border 1px solid $hair
  background $surface-2
  font-family $mono
  font-size .9rem
  color $txt-soft
  margin 1rem 0

.pulse-state p
  margin 0

.pulse-state.is-loading
  border-color $hair
  color $txt-soft

.pulse-state.is-error
  border-color rgba(255,107,107,.5)
  background rgba(255,107,107,.08)
  color $down

.pulse-state.is-empty
  border-style dashed
  color $txt-mute

.pulse-state .spin
  width 1.1rem
  height 1.1rem
  border-radius 50%
  border 2px solid $hair
  border-top-color $brand
  animation pulse-spin .8s linear infinite
  flex-shrink 0

/* ── Services grid ──────────────────────────────────────────────── */

.pulse-grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(250px, 1fr))
  gap 1rem
  margin 1.25rem 0

.app-pulse .card.svc
  background linear-gradient(180deg, $surface-2, $surface)
  border 1px solid $hair
  border-radius 14px
  padding 1.1rem 1.2rem 1.15rem
  box-shadow none
  position relative
  overflow hidden
  transition border-color .15s ease, transform .15s ease

.app-pulse .card.svc:hover
  transform translateY(-2px)
  border-color $brand

/* Reset the <p> wrappers markdown adds around interpolated values so the
   card layout stays tight. */
.app-pulse .card.svc p
  margin 0

/* Left status rail per row, driven by `.class when` */
.app-pulse .card.svc::before
  content ""
  position absolute
  inset 0 auto 0 0
  width 4px
  background $hair

.app-pulse .card.svc-ok::before
  background $ok
.app-pulse .card.svc-warn::before
  background $warn
.app-pulse .card.svc-down::before
  background $down
  box-shadow 0 0 16px $down

.svc-top
  display flex
  align-items flex-start
  justify-content space-between
  gap .6rem
  margin 0 0 .85rem

.app-pulse .card.svc strong
  font-size 1.02rem
  color $txt
  display block

.svc-region
  display block
  font-family $mono
  font-size .72rem
  letter-spacing .08em
  text-transform uppercase
  color $txt-mute
  margin-top .2rem

/* Status pill — recolored per state via the row class. */
.app-pulse .card.svc .pill
  font-family $mono
  letter-spacing .08em
  background $surface-3
  color $txt-soft
  border 1px solid $hair
  flex-shrink 0

.app-pulse .card.svc-ok .pill
  background rgba(43,212,168,.14)
  color $ok
  border-color rgba(43,212,168,.4)

.app-pulse .card.svc-warn .pill
  background rgba(240,180,41,.14)
  color $warn
  border-color rgba(240,180,41,.4)

.app-pulse .card.svc-down .pill
  background rgba(255,107,107,.16)
  color $down
  border-color rgba(255,107,107,.45)

/* Metric readout row inside each service card. */
.svc-metrics
  display flex
  gap 1.4rem
  margin-top .25rem

.svc-metric
  display flex
  flex-direction column
  gap .15rem

.svc-metric .m-val
  font-family $mono
  font-size 1.15rem
  font-weight 600
  color $txt
  letter-spacing -.01em

.svc-metric .m-key
  font-size .68rem
  text-transform uppercase
  letter-spacing .08em
  color $txt-mute

.app-pulse .card.svc-warn .m-val.is-latency
  color $warn
.app-pulse .card.svc-down .m-val.is-latency
  color $down

/* Decorative unicode sparkline strip — CSS-only, one glyph per status.
   (The spark array can't be transformed via directives, so the trend
   line is purely ornamental and set by the row's status class.) */
.svc-spark
  margin-top .9rem
  font-family $mono
  font-size .82rem
  letter-spacing .06em
  color $txt-mute
  white-space nowrap
  overflow hidden

.app-pulse .card.svc-ok .svc-spark::before
  content "▁▂▃▂▃▄▃▅ steady"
  color $ok
.app-pulse .card.svc-warn .svc-spark::before
  content "▃▅▄▆▅▇▆█ rising"
  color $warn
.app-pulse .card.svc-down .svc-spark::before
  content "▆▇█▁▁▁▁▁ dropped"
  color $down

/* ── Legend ─────────────────────────────────────────────────────── */

.pulse-legend
  display flex
  flex-wrap wrap
  gap 1.25rem
  margin 1rem 0
  font-family $mono
  font-size .78rem
  color $txt-soft

.pulse-legend span
  display inline-flex
  align-items center
  gap .45rem

.pulse-legend span::before
  content ""
  width .6rem
  height .6rem
  border-radius 50%

.pulse-legend .lg-ok::before
  background $ok
.pulse-legend .lg-warn::before
  background $warn
.pulse-legend .lg-down::before
  background $down

/* ── Source reveal (dark variant) ───────────────────────────────── */

.app-pulse .source-reveal
  background $surface-2
  border 1px solid $hair
  margin-top 2rem

.app-pulse .source-reveal summary
  color $brand

.app-pulse .source-reveal pre
  background #060a0f
  box-shadow inset 0 0 0 1px $hair

/* Animations (@keyframes pulse-beat / pulse-spin) and the
   prefers-reduced-motion guard live in an inline <style> in index.wd,
   because the .skin compiler emits one rule per declaration — which
   would split a multi-stop @keyframes into separate (last-wins) blocks. */

/* ── Responsive ─────────────────────────────────────────────────── */

@media (max-width: 600px)
  .app-pulse
    padding 1.4rem 1.1rem 1.8rem
  .pulse-grid
    grid-template-columns 1fr
