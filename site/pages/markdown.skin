tokens
  ink #171717
  paper #fbfaf7
  panel #ffffff
  line #dedbd3
  accent #16645a
  radius 8px

html
  bg $paper

page
  max-width 760px
  margin 0 auto
  padding 3rem 2rem 5rem
  font ui-serif, Georgia, Cambria, serif
  color $ink
  bg $paper
  line-height 1.7

h1
  font-size 3rem
  line-height 1
  margin 2rem 0 1rem

h2
  margin-top 2.4rem
  padding-top 1.2rem
  border-top 1px solid $line

a
  color $accent

code
  bg $panel
  border 1px solid $line
  padding .08rem .28rem
  radius 5px

blockquote
  margin 1rem 0
  padding .5rem 1.2rem
  border-left 3px solid $accent
  bg $panel
  radius $radius

table
  border-collapse collapse
  bg $panel

th
  text-align left
  border 1px solid $line
  padding .5rem .9rem
  bg #f1ede4

td
  border 1px solid $line
  padding .5rem .9rem

img
  width 64px
  height 64px
