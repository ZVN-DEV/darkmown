/* ===================================================================
   Compass — a guided product-finder quiz.
   Identity: playful & warm. A big friendly rounded card centered on a
   soft gradient backdrop, large question type, satisfying pill answers,
   a celebratory result. Distinct accent ($brand, warm amber) scoped to
   .app-compass so it never leaks into the shared design system. Inherits
   tokens + components from base.skin; dark overrides verified below.
   =================================================================== */

.app-compass
  --brand #e0894a
  --brand-deep #c46f33
  --brand-soft #fbeede
  --glow-1 #fcefe0
  --glow-2 #f6e7f1
  --glow-3 #f9f4ea

@media (prefers-color-scheme: dark)
  .app-compass
    --brand #f0a868
    --brand-deep #f6c08c
    --brand-soft #2e2014
    --glow-1 #1b1610
    --glow-2 #181219
    --glow-3 #14110d

/* ── The stage: a soft gradient backdrop, card floated dead center ──── */

.app-compass
  max-width 100%
  padding 0

.compass-stage
  min-height calc(100vh - 60px)
  display flex
  align-items center
  justify-content center
  padding 3rem 1.25rem 4rem
  background radial-gradient(120% 90% at 15% 0%, var(--glow-1) 0%, transparent 55%), radial-gradient(110% 90% at 95% 10%, var(--glow-2) 0%, transparent 50%), radial-gradient(140% 120% at 50% 110%, var(--glow-3) 0%, transparent 60%)

/* ── The card ───────────────────────────────────────────────────────── */

.compass-card
  width 100%
  max-width 560px
  background $panel
  border 1px solid $line
  border-radius 28px
  padding 2.75rem 2.5rem 2.5rem
  box-shadow 0 1px 0 rgba(255,255,255,.6) inset, 0 24px 60px -28px rgba(28,24,20,.45), 0 8px 22px -16px rgba(28,24,20,.3)
  text-align center

@media (prefers-color-scheme: dark)
  .compass-card
    box-shadow 0 1px 0 rgba(255,255,255,.04) inset, 0 28px 70px -30px rgba(0,0,0,.7)

@media (max-width: 540px)
  .compass-card
    padding 2rem 1.4rem 1.75rem
    border-radius 22px

/* ── Top: eyebrow + progress rail ───────────────────────────────────── */

.compass-top
  margin-bottom 2rem

.compass-eyebrow
  display inline-block
  text-transform uppercase
  letter-spacing .16em
  font-size .72rem
  font-weight 700
  color var(--brand-deep)
  margin 0 0 1rem

.compass-eyebrow.is-result
  color var(--brand-deep)

.compass-rail
  position relative
  height 8px
  border-radius 999px
  background $sunk
  overflow hidden

.compass-rail::after
  content ""
  position absolute
  inset 0
  width 25%
  border-radius 999px
  background linear-gradient(90deg, var(--brand) 0%, var(--brand-deep) 100%)
  transition width .45s cubic-bezier(.34, 1.56, .64, 1)

.compass-rail.at-1::after
  width 25%

.compass-rail.at-2::after
  width 50%

.compass-rail.at-3::after
  width 75%

.compass-rail.at-4::after
  width 100%

/* ── The question ───────────────────────────────────────────────────── */

.compass-card h2
  font-size clamp(1.7rem, 5vw, 2.3rem)
  line-height 1.12
  letter-spacing -.02em
  margin .2rem 0 0

.compass-lead
  color $muted
  font-size 1.02rem
  margin .85rem auto 0
  max-width 38ch

/* ── Answers: big satisfying pills ──────────────────────────────────── */

.compass-answers
  display flex
  flex-direction column
  gap .7rem
  margin 1.9rem 0 0

.compass-answers button
  display block
  width 100%
  margin 0
  padding 1.05rem 1.3rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size 1.05rem
  font-weight 550
  line-height 1.3
  text-align left
  color $ink
  background $paper-2
  border 1.5px solid $line
  border-radius 16px
  cursor pointer
  transition transform .14s cubic-bezier(.34,1.56,.64,1), box-shadow .14s ease, border-color .14s ease, background .14s ease

.compass-answers button:hover
  transform translateY(-2px)
  border-color var(--brand)
  background var(--brand-soft)
  box-shadow 0 12px 26px -16px rgba(196,111,51,.55)

.compass-answers button:active
  transform translateY(0) scale(.985)

.compass-answers button:focus-visible
  outline 3px solid var(--brand)
  outline-offset 2px

/* ── Result: a result that feels earned ─────────────────────────────── */

.compass-result
  padding .4rem 0 .2rem

.compass-burst
  font-size 3.4rem
  line-height 1
  margin 0 0 .4rem
  animation pop .55s cubic-bezier(.34,1.56,.64,1) both

.compass-result h1
  font-size clamp(2rem, 7vw, 2.9rem)
  line-height 1.05
  letter-spacing -.025em
  margin .15rem 0 0
  background linear-gradient(100deg, var(--brand-deep), var(--brand))
  -webkit-background-clip text
  background-clip text
  color transparent

.compass-why
  color $ink-soft
  font-size 1.06rem
  line-height 1.6
  margin 1rem auto 0
  max-width 40ch

.compass-why strong
  color var(--brand-deep)

/* ── CTA: the styled shop link ──────────────────────────────────────── */

.compass-cta
  display inline-flex
  align-items center
  gap .45rem
  margin 1.7rem 0 0
  padding .95rem 1.7rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size 1.02rem
  font-weight 650
  color #fff
  text-decoration none
  background linear-gradient(100deg, var(--brand) 0%, var(--brand-deep) 100%)
  border-radius 999px
  box-shadow 0 14px 30px -12px rgba(196,111,51,.6)
  transition transform .14s ease, box-shadow .14s ease

.compass-cta:hover
  color #fff
  transform translateY(-2px)
  box-shadow 0 20px 38px -14px rgba(196,111,51,.7)

.compass-cta:focus-visible
  outline 3px solid var(--brand-deep)
  outline-offset 3px

/* ── Start over ─────────────────────────────────────────────────────── */

.compass-restart
  margin 1.7rem 0 0

.compass-restart button
  margin 0
  padding .55rem 1.1rem
  font-family system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .9rem
  font-weight 550
  color $muted
  background transparent
  border 1.5px solid $line
  border-radius 999px
  cursor pointer
  transition color .14s ease, border-color .14s ease

.compass-restart button:hover
  color var(--brand-deep)
  border-color var(--brand)

.compass-restart button:focus-visible
  outline 3px solid var(--brand)
  outline-offset 2px

/* ── Source reveal sits below the card, full-width-ish, calm ────────── */

.app-compass .source-reveal
  max-width 560px
  margin 1.75rem auto 0
