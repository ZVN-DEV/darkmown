tokens
  ink #171717
  paper #fbfaf7
  panel #ffffff
  line #e4e1d8
  accent #16645a
  warm #a83f2a
  radius 10px

main
  max-width 760px
  margin 0 auto
  padding 2.5rem 1.5rem 4rem
  font ui-sans-serif, system-ui, sans-serif
  color $ink

h1
  font-size 2.1rem
  letter-spacing -0.02em

.boundary
  margin 1.5rem 0
  padding 1rem 1.2rem
  border-left 3px solid $warm
  background #fcf4ef
  border-radius $radius
  font-size .95rem

.roadmap-row
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  padding .75rem 1rem
  margin .5rem 0
  background $panel
  border 1px solid $line
  border-radius $radius

.badge
  font-size .8rem
  font-weight 600
  padding .2rem .6rem
  border-radius 999px
  white-space nowrap

.badge.shipped
  background #e3f3ec
  color $accent

.badge.wip
  background #fef0e6
  color $warm

.badge.blocked
  background #f3e3e3
  color #9a2a2a

button
  display inline-flex
  align-items center
  justify-content center
  gap .4rem
  background $accent
  color white
  border 1px solid $accent
  padding .55rem 1rem
  margin .25rem .4rem .25rem 0
  border-radius 999px
  font-size .92rem
  font-weight 560
  cursor pointer
  appearance none
  transition transform .14s cubic-bezier(.2,.7,.3,1), box-shadow .14s ease

button:hover
  transform translateY(-1px)
  box-shadow 0 8px 18px -8px rgba(15,107,94,.5)

button:focus-visible
  outline 2px solid $accent
  outline-offset 2px

input
  font-size 1rem
  padding .55rem .75rem
  border 1px solid $line
  border-radius 8px
  width 100%
  max-width 22rem
  margin .3rem 0
  appearance none
  transition border-color .14s ease, box-shadow .14s ease

input:focus-visible
  outline none
  border-color $accent
  box-shadow 0 0 0 3px rgba(15,107,94,.18)
