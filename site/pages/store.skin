tokens
  ink #171717
  paper #faf8f3
  panel #ffffff
  line #dedbd3
  accent #16645a
  warm #a83f2a
  radius 8px

page
  margin 0
  font ui-serif, Georgia, Cambria, serif
  color $ink
  bg $paper
  line-height 1.7

main
  max-width 820px
  margin 0 auto
  padding 3rem 2rem 5rem

h1
  font-size 3rem
  line-height 1

h2
  margin-top 2.4rem
  border-top 1px solid $line
  padding-top 1.2rem

a
  color $accent

button
  border 1px solid $ink
  bg $ink
  color white
  padding .72rem 1rem
  margin .3rem .5rem .3rem 0
  radius $radius
  font inherit
  cursor pointer

button:hover
  bg $accent
  border-color $accent

input
  padding .7rem .9rem
  border 1px solid $line
  radius $radius
  font inherit
  bg $panel
  width 100%
  max-width 360px
  margin 1rem 0

#shop
  border 1px solid $line
  bg $panel
  padding .4rem 1.4rem 1.4rem
  margin 1.5rem 0
  radius $radius

.line
  border 1px solid $line
  bg $paper
  padding .55rem 1.1rem
  margin .45rem 0
  radius $radius
