/* The Darkmown vs. Markdoc comparison, moved off the landing page.
   Layers on /base.wd. Class names match the `::: name .class` containers
   in markdoc.wd. The page contains no raw HTML. */

.versus
  display grid
  grid-template-columns 1fr 1fr
  gap 1.25rem
  align-items start
  margin 2.75rem 0 2.5rem

.vs-card
  border 1px solid $line
  radius $radius
  bg $panel
  padding 1.35rem
  display flex
  flex-direction column
  min-width 0
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.vs-card.vs-dark
  background linear-gradient(180deg, $accent-soft, $panel)
  border 1px solid $accent

/* First line of each card is the filename, authored as inline code. */
.vs-card > p:first-child
  margin 0 0 .85rem
  font-size .82rem
  color $muted

.vs-card > p:first-child code
  font-size .82rem
  color $ink

.vs-card pre
  margin .25rem 0 .75rem
  padding-right 1rem
  font-size .78rem
  line-height 1.55
  overflow-x auto

.vs-card p
  font-size .92rem

.vs-card > p:last-child
  margin auto 0 0
  padding-top .5rem

@media (max-width: 720px)
  .versus
    grid-template-columns 1fr
    gap 1rem
