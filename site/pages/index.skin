/* Landing page. Layers on /base.wd (tokens, type, components, dark mode).
   Only landing-specific layout lives here.

   The page itself contains no raw HTML: every block below is produced by a
   `::: name` container, a markdown element, or a directive. Class names match
   the container names in site/pages/index.wd. */

/* ── Hero ───────────────────────────────────────────────────────── */

.hero
  padding 3.5rem 0 2.75rem
  border-bottom 1px solid $line
  margin-bottom 2.5rem

.hero h1
  max-width 15ch
  font-size clamp(2.4rem, 6vw, 3.6rem)

.hero h1 em
  font-style italic
  color $accent

.hero > p
  max-width 60ch
  font-size 1.18rem
  color $ink-soft
  margin 1rem 0 1.75rem

/* The install command is a plain ```sh fence; index.js appends the copy
   button, so the markup stays directive-only and works with JS off. */
.hero pre
  position relative
  max-width 34rem
  margin 0 0 1.75rem
  padding .85rem 1rem
  border 1px solid $line
  radius 10px
  bg $sunk

.hero pre code
  font-size .95rem
  color $ink
  white-space nowrap

.hero pre.has-copy
  padding-right 5.5rem

.hero pre .copy-cmd
  position absolute
  top 50%
  right .6rem
  transform translateY(-50%)
  padding .3rem .7rem
  border 1px solid $line
  radius 7px
  bg $panel
  color $ink-soft
  font-family inherit
  font-size .8rem
  cursor pointer

.hero pre .copy-cmd:hover
  color $ink
  border-color $accent

.hero pre .copy-cmd.is-copied
  color $accent
  border-color $accent

.hero-cta
  display flex
  flex-wrap wrap
  gap .6rem
  margin 0

/* ── Source + the same file running, as one paired module ───────── */

/* The source block and the live demo are deliberately the same width and sit
   inside one bordered card, so the "this text produced that UI" claim reads as
   a single before/after unit rather than two unrelated page chunks. */
.pair
  max-width 46rem
  margin 1.25rem 0 2.5rem
  padding 1.25rem
  border 1px solid $line
  radius $radius
  bg $panel

.pairlabel
  margin 0 0 .5rem
  font-size .78rem
  text-transform uppercase
  letter-spacing .07em
  color $muted

.pairlabel code
  font-size .78rem
  text-transform none
  letter-spacing 0
  color $ink

.pair > pre
  margin 0 0 1.5rem

.pair .pairlabel + .demo
  margin 0

.demo
  border 1px solid $accent
  radius $radius-sm
  background color-mix(in srgb, $accent-soft 45%, $panel)
  padding 1.15rem 1.25rem 1rem

.demo input[data-wd-bind-input]
  width 100%
  box-sizing border-box
  font-family inherit
  font-size .95rem
  padding .55rem .7rem
  border 1px solid $line
  radius 8px
  bg $panel
  color $ink
  margin 0 0 .75rem

.demo .product
  display flex
  align-items center
  justify-content space-between
  gap .75rem
  padding .5rem .7rem
  margin .35rem 0
  bg $panel
  border 1px solid $line
  radius 8px
  font-size .95rem

.demo .product p
  margin 0

.demo .product button
  border 0
  bg $accent
  color white
  font-family inherit
  font-size .82rem
  padding .4rem .8rem
  radius 999px
  cursor pointer
  flex-shrink 0

.demo .product button:hover
  bg $accent-deep

.demo > p:last-of-type
  margin .85rem 0 0
  font-size .95rem

/* ── Live data strip (:fetch stars + visits) ────────────────────── */

.livestrip
  display grid
  grid-template-columns repeat(4, 1fr)
  gap 1rem
  margin 1.5rem 0 2rem
  padding 1.35rem 0
  border-top 1px solid $line-soft
  border-bottom 1px solid $line-soft

/* Every stat is structurally identical: the value is a bare <p> (either plain
   prose or the body of an `:if` region), the label is its own `.statlabel`
   container. Keeping the label in a container is what stops markdown from
   folding value and label into one paragraph, which is exactly what happened
   when they were two adjacent lines. */
.stat
  display flex
  flex-direction column
  gap .2rem
  min-width 0

.stat > p
  margin 0
  font-size 1.85rem
  line-height 1.05
  color $accent
  letter-spacing -.02em
  font-variant-numeric tabular-nums

/* The `:if` lifecycle regions wrap the value; unwrap them for layout so the
   value sits on the same baseline whether it is static or fetched. */
.stat > div[data-wd-if] p
  margin 0
  font-size 1.85rem
  line-height 1.05
  color $accent
  letter-spacing -.02em
  font-variant-numeric tabular-nums

.statlabel
  font-size .88rem
  line-height 1.35
  color $ink-soft
  max-width 20ch

.statlabel p
  margin 0

@media (max-width: 720px)
  .livestrip
    grid-template-columns 1fr 1fr
    gap 1.25rem

/* ── Demo-directive widgets (`:try`) ────────────────────────────── */

.try-card
  display inline-flex
  align-items center
  gap .65rem
  margin .35rem .5rem .35rem 0
  padding .75rem 1rem
  border 1px solid $line
  radius 999px
  bg $panel
  text-decoration none
  color $ink

.try-card:hover
  border-color $accent

.try-card span
  color white
  bg $accent
  padding .1rem .5rem
  radius 999px
  font-size .8rem
