/* Landing page — layers on /base.wd (tokens, type, components, dark mode).
   Only landing-specific layout lives here. */

/* ── Hero ───────────────────────────────────────────────────────── */

.hero
  padding 3.5rem 0 2.75rem
  border-bottom 1px solid $line
  margin-bottom 2.5rem

.hero h1
  max-width 16ch

.hero h1 em
  font-style italic
  color $accent

.hero > p
  max-width 64ch
  font-size 1.18rem
  color $ink-soft
  margin 1rem 0 1.75rem

.hero .eyebrow
  background $accent-soft
  padding .3rem .7rem
  radius 999px

.hero-cta
  display flex
  flex-wrap wrap
  margin-bottom 1.5rem

.hero-install
  display inline-flex
  align-items center
  gap .55rem
  max-width 100%
  margin 0 0 2rem
  padding .7rem 1rem
  border 1px solid $line
  radius 10px
  bg $sunk
  font-family ui-monospace, SFMono-Regular, Menlo, monospace
  overflow-x auto

.hero-install::before
  content "$"
  color $accent
  font-weight 700
  flex-shrink 0

.hero-install code
  font-family inherit
  font-size .95rem
  color $ink
  white-space nowrap

.hero-stats
  display grid
  grid-template-columns repeat(4, auto)
  gap 1.25rem 2.5rem
  list-style none
  padding 0
  margin 0
  border-top 1px solid $line-soft
  padding-top 1.5rem

.hero-stats li
  display flex
  flex-direction column

.hero-stats strong
  font-size 1.6rem
  color $accent
  letter-spacing -.02em

.hero-stats span
  font-size .82rem
  color $muted
  max-width 18ch

@media (max-width: 720px)
  .hero-stats
    grid-template-columns 1fr 1fr

/* ── vs-Markdoc comparison ──────────────────────────────────────── */

.versus
  display grid
  grid-template-columns 1fr 1fr
  gap 1.25rem
  align-items start
  margin 2.5rem 0 1rem

.vs-card
  border 1px solid $line
  radius $radius
  bg $panel
  padding 1.35rem
  display flex
  flex-direction column
  min-width 0
  box-shadow 0 1px 2px rgba(28,24,20,.04)

.vs-card.vs-dark
  background linear-gradient(180deg, $accent-soft, $panel)
  border 1px solid $accent

.vs-head
  display flex
  align-items baseline
  justify-content space-between
  gap .75rem
  margin-bottom .85rem

.vs-tag
  font-family ui-monospace, SFMono-Regular, Menlo, monospace
  font-size .72rem
  font-weight 700
  text-transform uppercase
  letter-spacing .08em
  padding .25rem .55rem
  radius 999px

.vs-tag-wd
  color white
  bg $accent

.vs-tag-md
  color $muted
  bg $sunk
  border 1px solid $line

.vs-sub
  font-family ui-monospace, SFMono-Regular, Menlo, monospace
  font-size .82rem
  color $muted

.vs-card pre
  margin .25rem 0 0
  font-size .8rem
  line-height 1.55

.vs-live-label
  margin 1rem 0 .35rem
  font-size .88rem
  color $muted
  font-style italic

.vs-live
  border 1px dashed $accent
  radius $radius-sm
  background color-mix(in srgb, $accent-soft 50%, $panel)
  padding 1rem 1.1rem .85rem
  margin .15rem 0 0

.vs-live input[data-wd-bind-input]
  width 100%
  box-sizing border-box
  font-family inherit
  font-size .95rem
  padding .55rem .7rem
  border 1px solid $line
  radius 8px
  bg $panel
  color $ink
  margin 0 0 .75rem

.vs-live .product
  display flex
  align-items center
  justify-content space-between
  gap .75rem
  padding .5rem .7rem
  margin .35rem 0
  bg $panel
  border 1px solid $line
  radius 8px
  font-size .95rem

.vs-live .product p
  margin 0

.vs-live .product button
  border 0
  bg $accent
  color white
  font-family inherit
  font-size .82rem
  padding .4rem .8rem
  radius 999px
  cursor pointer
  flex-shrink 0

.vs-live .product button:hover
  bg $accent-deep

.vs-live > p:last-of-type
  margin .85rem 0 0
  font-size .95rem

.vs-needs
  margin 1rem 0 0
  padding 1rem 1.1rem
  border-left 3px solid $warm
  bg $warm-soft
  radius 8px

.vs-needs strong
  color $warm
  font-size .92rem

.vs-needs pre
  margin .7rem 0 .6rem
  font-size .78rem

.vs-needs-foot
  display block
  font-size .85rem
  color $muted

.vs-caption
  margin auto 0 0
  padding-top 1rem
  font-style italic
  color $ink
  font-size .95rem

.vs-card.vs-dark .vs-caption
  color $accent-deep

@media (max-width: 720px)
  .versus
    grid-template-columns 1fr
    gap 1rem

/* ── Secondary value props ──────────────────────────────────────── */

.props
  margin 1.5rem 0 0

.props h2
  margin-top 1.5rem

/* ── Demo-directive widgets (`:try`, feature-card include, index.js) ─ */

.try-card
  display inline-flex
  align-items center
  gap .65rem
  margin .35rem .5rem .35rem 0
  padding .75rem 1rem
  border 1px solid $line
  radius 999px
  bg $panel
  text-decoration none
  color $ink

.try-card:hover
  border-color $accent

.try-card span
  color white
  bg $accent
  padding .1rem .5rem
  radius 999px
  font-size .8rem

.feature-card
  display grid
  gap .35rem
  margin 1rem 0
  padding 1.1rem 1.25rem
  bg $panel
  border 1px solid $line
  radius $radius

.feature-card strong
  color $warm

.pulse-button
  border 0
  bg $ink
  color $paper
  padding .85rem 1.15rem
  radius 999px
  font-family inherit
  cursor pointer

.pulse-button.is-on
  bg $warm

.sprint-board
  display grid
  grid-template-columns repeat(auto-fit, minmax(130px, 1fr))
  gap 1rem
  margin 1rem 0

.sprint-board article
  bg $panel
  border 1px solid $line
  padding 1rem
  radius $radius

.sprint-board span
  display block
  color $accent
  font-size .9rem
