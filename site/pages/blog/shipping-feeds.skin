/* Colocated post styling — a .skin next to a .md attaches automatically, so
   these prose pages stay static (zero JS) yet still read on-brand. A .md can't
   @include /base.wd, so this reading skin carries the site's tokens itself.
   Kept in sync with site/_/base.skin; copy it beside each new post. */

tokens
  ink #1c1814
  ink-soft #4b4239
  muted #756a5d
  paper #faf8f3
  panel #ffffff
  sunk #efe9dc
  line #e7e1d4
  accent #0f6b5e
  accent-deep #0a4f45
  accent-soft #e3f0ec
  code-bg #1b2420
  code-ink #e9efe7
  code-line #2c3b34
  radius 12px

tokens dark
  ink #ece6db
  ink-soft #c3bbab
  muted #9a9081
  paper #14110d
  panel #1e1913
  sunk #221d17
  line #2f281f
  accent #5ccab4
  accent-deep #8fe0cf
  accent-soft #16302a
  code-bg #100d0a
  code-ink #e4ebe2
  code-line #2a231b

html
  bg $paper

page
  max-width 720px
  margin 0 auto
  padding 3rem 1.5rem 5rem
  font-family ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, Cambria, serif
  font-size 18px
  line-height 1.7
  color $ink
  bg $paper
  -webkit-font-smoothing antialiased
  text-rendering optimizeLegibility

h1
  font-size clamp(2rem, 5vw, 2.8rem)
  line-height 1.12
  letter-spacing -.022em
  margin 1rem 0 1.25rem
  color $ink

h2
  font-size 1.5rem
  line-height 1.2
  letter-spacing -.012em
  margin 2.4rem 0 .6rem
  color $ink

h3
  font-size 1.2rem
  margin 1.8rem 0 .4rem
  color $ink

p
  margin 1.1rem 0

a
  color $accent
  text-underline-offset 2px

a:hover
  color $accent-deep

strong
  font-weight 650
  color $ink

hr
  border 0
  border-top 1px solid $line
  margin 2.5rem 0

ul, ol
  margin 1.1rem 0
  padding-left 1.4rem

li
  margin .35rem 0

code
  font-family ui-monospace, "SF Mono", Menlo, Consolas, monospace
  font-size .88em
  bg $sunk
  color $accent-deep
  padding .12rem .36rem
  radius 6px

pre
  bg $code-bg
  color $code-ink
  padding 1.2rem 1.35rem
  margin 1.5rem 0
  radius $radius
  overflow-x auto
  line-height 1.62
  font-size .87rem
  box-shadow inset 0 0 0 1px $code-line

pre code
  bg transparent
  color inherit
  padding 0
  font-size 1em

blockquote
  margin 1.6rem 0
  padding .6rem 1.3rem
  border-left 3px solid $accent
  color $ink-soft
  font-style italic
