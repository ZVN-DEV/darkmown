tokens
  ink #171717
  paper #faf8f3
  panel #ffffff
  line #dedbd3
  accent #16645a
  warm #a83f2a
  radius 8px

page
  margin 0
  font ui-serif, Georgia, Cambria, serif
  color $ink
  bg $paper
  line-height 1.7

main
  max-width 820px
  margin 0 auto
  padding 3rem 2rem 5rem

h1
  font-size 3rem
  line-height 1

h2
  margin-top 2rem
  border-top 1px solid $line
  padding-top 1.2rem

button
  display inline-flex
  align-items center
  justify-content center
  gap .5rem
  border 1px solid $accent
  bg $accent
  color white
  padding .6rem 1.1rem
  margin .3rem .5rem .3rem 0
  radius 999px
  font system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
  font-size .92rem
  font-weight 560
  line-height 1.15
  cursor pointer
  appearance none
  box-shadow 0 1px 2px rgba(23,23,23,.08)
  transition transform .14s cubic-bezier(.2,.7,.3,1), box-shadow .14s ease, background .14s ease, border-color .14s ease

button:hover
  bg $accent
  border-color $accent
  transform translateY(-1px)
  box-shadow 0 8px 18px -8px rgba(22,100,90,.5)

button:active
  transform translateY(0)
  box-shadow 0 1px 2px rgba(23,23,23,.08)

button:focus-visible
  outline 2px solid $accent
  outline-offset 2px

button:disabled
  opacity .5
  cursor not-allowed
  box-shadow none
  transform none

a
  color $accent

ul
  border 1px solid $line
  bg $panel
  padding 1rem 1rem 1rem 2rem
  radius $radius

.tally-card
  border 1px solid $line
  bg $panel
  padding .25rem 1.2rem 1.2rem
  margin 1rem 0
  radius $radius

.tally-card h3
  color $warm

.member-card
  border 1px solid $line
  bg $panel
  padding .8rem 1.2rem
  margin .6rem 0
  radius $radius

form
  display flex
  gap .6rem
  flex-wrap wrap
  margin 1rem 0

input
  padding .62rem .85rem
  border 1px solid $line
  radius $radius
  font inherit
  font-size .95rem
  bg $panel
  appearance none
  transition border-color .14s ease, box-shadow .14s ease

input:hover
  border-color $accent

input:focus-visible
  outline none
  border-color $accent
  box-shadow 0 0 0 3px rgba(22,100,90,.18)

.pulse-button
  border 1px solid $warm
  bg $warm
  color white
  padding .6rem 1.1rem
  radius 999px
  font inherit
  cursor pointer

.pulse-button:hover
  transform translateY(-1px)
  box-shadow 0 8px 18px -8px rgba(168,63,42,.5)

.tally-card
  border 1px solid $line
  bg $panel
  padding .25rem 1.2rem 1.2rem
  margin 1rem 0
  radius $radius
