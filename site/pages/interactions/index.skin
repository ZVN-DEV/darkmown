main.app-interactions
  max-width 760px
  margin 0 auto
  padding 2.5rem 1.5rem

.ix-eyebrow
  text-transform uppercase
  letter-spacing .08em
  font-size .8rem
  opacity .7

.ix-tagline
  font-size 1.05rem
  opacity .85
  margin-top .5rem

.ix-panel
  margin 1.5rem 0
  padding 1.5rem

.ix-panel h2
  margin-top 0

.ix-note
  margin-top 1rem
  font-size .9rem
  opacity .7

.readout
  margin-top .75rem
  font-size 1.1rem

input[type=range]
  width 100%
  accent-color $accent

.sortlist .row
  display flex
  align-items center
  gap .6rem
  padding .7rem .9rem
  margin .4rem 0
  border 1px solid $line
  radius 10px
  background $paper
  cursor grab
  user-select none

.sortlist .row[data-wd-dragging]
  opacity .6
  cursor grabbing

.sortlist .row:focus-visible
  outline 2px solid $accent
  outline-offset 2px

.grip
  color $muted
  font-size 1.1rem

.wd-carousel
  position relative
  margin-top .5rem

.wd-carousel-track
  display flex
  overflow-x auto
  scroll-snap-type x mandatory
  scroll-behavior smooth
  gap 1rem

.wd-carousel-track .slide
  flex 0 0 100%
  scroll-snap-align start
  border 1px solid $line
  radius 12px
  padding 1.75rem
  background $paper

.wd-carousel-prev, .wd-carousel-next
  position absolute
  top 40%
  border 1px solid $line
  background $paper
  color $ink
  radius 999px
  width 2.25rem
  height 2.25rem
  cursor pointer

.wd-carousel-prev
  left -.5rem

.wd-carousel-next
  right -.5rem

.wd-carousel-dots
  display flex
  justify-content center
  gap .5rem
  margin-top .75rem

.wd-carousel-dot
  width .6rem
  height .6rem
  padding 0
  border 0
  radius 999px
  background $line
  cursor pointer

.wd-carousel-dot[aria-current=true]
  background $accent
