tokens
  ink #1a1a1a
  paper #ffffff
  panel #ffffff
  line #dedbd3
  accent #16645a
  radius 8px

tokens dark
  ink #f0f0f0
  paper #14140f
  panel #1e1d18
  line #34322b
  accent #5fd0c0

page
  margin 0
  font ui-serif, Georgia, Cambria, serif
  color $ink
  bg $paper
  line-height 1.7

main
  max-width 820px
  margin 0 auto
  padding 3rem 2rem 5rem

h1
  font-size 3rem
  line-height 1

h2
  margin-top 2.4rem
  border-top 1px solid $line
  padding-top 1.2rem

a
  color $accent

pre
  bg $panel
  border 1px solid $line
  padding 1rem
  radius $radius
  overflow-x auto

.swatch
  border 1px solid $line
  bg $panel
  color $ink
  padding 1.4rem
  margin 1.5rem 0
  radius $radius
