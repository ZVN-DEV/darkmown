{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "removeComments": false,
    // TypeScript 6 requires rootDir to be explicit once the inferred common
    // source directory is ambiguous (TS5011); without it `npm run types` errors
    // and emits nothing, so the committed types/*.d.ts silently go stale.
    "rootDir": "./src",
    "outDir": "types"
  },
  "include": [
    "src/builder.js",
    "src/compiler.js",
    "src/router.js",
    "src/skin.js",
    "src/scaffold.js",
    "src/config.js",
    "src/statics.js",
    "src/dev.js",
    "src/tools/index.js"
  ]
}
