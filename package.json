{
  "name": "@zvndev/darkmown",
  "version": "2.7.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Darkmown — the markdown framework. Plain .md stays plain; rename to .wd for loops, state, includes, and tiny reactive islands. Zero JS on static pages.",
  "bin": {
    "darkmown": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./catalog": {
      "types": "./types/catalog.d.ts",
      "default": "./src/catalog.js"
    },
    "./tools": {
      "types": "./types/tools/index.d.ts",
      "default": "./src/tools/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "node src/cli.js build",
    "build:playground": "node scripts/build-playground.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "runtime:size": "node scripts/size-check.mjs",
    "predev": "node scripts/build-runtime.mjs",
    "dev": "node src/cli.js dev",
    "test": "node --test tests/*.test.js",
    "test:cov": "node scripts/test-coverage-gate.mjs 100",
    "test:e2e": "playwright test",
    "test:extension": "npm --prefix editors/vscode ci && npm --prefix editors/vscode test",
    "pack:extension": "cd editors/vscode && npx --yes @vscode/vsce package",
    "typecheck": "tsc --noEmit",
    "types": "tsc -p tsconfig.types.json",
    "smoke": "node scripts/smoke-consumer.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "size:check": "node scripts/size-check.mjs",
    "prepare": "husky || true",
    "prepublish:check": "npm run typecheck && node scripts/build-runtime.mjs --check && npm run test:cov && npm run build && npm run runtime:size && npm audit --audit-level=high && npm run smoke",
    "prepublishOnly": "npm run prepublish:check",
    "og": "node scripts/og-image.mjs",
    "bench:build": "node scripts/bench-build.mjs"
  },
  "lint-staged": {
    "*.{js,json}": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "files": [
    "src",
    "src/runtime.min.js",
    "src/runtime.min.js.map",
    "types",
    "grammar",
    "site",
    "!site/_/og*.png",
    "docs/cli.md",
    "docs/spec-alignment.md",
    "AGENTS.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZVN-DEV/darkmown.git"
  },
  "homepage": "https://darkmown.com",
  "bugs": {
    "url": "https://github.com/ZVN-DEV/darkmown/issues"
  },
  "keywords": [
    "markdown",
    "framework",
    "static-site",
    "wd",
    "whateverdown",
    "zero-js",
    "reactive"
  ],
  "license": "MIT"
}
