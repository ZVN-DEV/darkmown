{
  "name": "@zvndev/darkmown",
  "version": "0.9.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Darkmown — the markdown framework. Plain .md stays plain; rename to .wd for loops, state, includes, and tiny reactive islands. Zero JS on static pages.",
  "bin": {
    "darkmown": "./src/cli.js"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "node src/cli.js build",
    "dev": "node src/cli.js dev",
    "test": "node --test tests/*.test.js",
    "test:cov": "node --test --experimental-test-coverage tests/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm test"
  },
  "files": [
    "src",
    "types",
    "site",
    "docs",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.21",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZVN-DEV/darkmown.git"
  },
  "homepage": "https://github.com/ZVN-DEV/darkmown#readme",
  "bugs": {
    "url": "https://github.com/ZVN-DEV/darkmown/issues"
  },
  "keywords": [
    "markdown",
    "framework",
    "static-site",
    "wd",
    "whateverdown",
    "zero-js",
    "reactive"
  ],
  "license": "MIT"
}
